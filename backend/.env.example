# ═══════════════════════════════════════════════════════════════════════════
#  DawaaCheck backend — environment template
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in the values below.
#  3. Never commit .env — it is gitignored, and should stay that way.
#
#  On Railway, set the same keys under Project → Variables instead of
#  shipping a .env file.
# ═══════════════════════════════════════════════════════════════════════════


# ── 1. ANTHROPIC API KEY  (required — verification cannot run without it) ────
#
#    >>>  PUT YOUR CLAUDE API KEY HERE  <<<
#
#    Create one at:  https://console.anthropic.com/settings/keys
#    It starts with "sk-ant-api03-".
#
#    Used by the three vision agents that read the pack:
#      agent 1  RAKIB  — registration and authenticity (front label)
#      agent 2  KASHIF — barcode and tamper detection  (back label)
#      agent 4  BASIR  — ingredient verification       (ingredients panel)
#
#    Without this key the backend still starts and serves its data endpoints,
#    but scan requests fail. The mobile app then falls back to on-device
#    verification, so it stays usable — see README, "Working offline".
#
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

#    Optional — override the vision model (default: claude-opus-4-6).
#    Pin this when you need a reproducible evaluation run.
# ANTHROPIC_VISION_MODEL=claude-opus-4-6


# ── 2. SUPABASE  (required — drug reference data + verification cache) ───────
#
#    Dashboard → Settings → API
#
#    SUPABASE_KEY must be the **service_role** key, not the anon key: the
#    backend writes scan results and cache entries, which RLS blocks for anon.
#    The service_role key must never be shipped to a client.
#
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

#    First-time database setup — run all four in the Supabase SQL editor, in
#    this order. The first two are complementary, not successive versions:
#      1. data/supabase_migration.sql     core tables (users, scans, DRAP) + RLS
#      2. data/supabase_migration_v2.sql  drug reference tables
#      3. data/search_optimization.sql    trigram indexes for medicine search
#      4. data/verification_cache.sql     verdict cache
#    then:  python data/upload_to_supabase.py   (loads reference data)


# ── 3. FIREBASE ADMIN  (optional — only for push notifications) ──────────────
#
#    Leave unset to run without push. Everything else works.
#
#    Local development — path to the service-account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-admin-sdk.json
#
#    Railway and similar — inline the same JSON on a single line:
# FIREBASE_ADMIN_CREDENTIALS={"type":"service_account","project_id":"..."}
#
# FIREBASE_PROJECT_ID=your-firebase-project-id


# ── 4. CORS  (optional) ──────────────────────────────────────────────────────
#
#    Comma-separated origins allowed to call the API.
#    Defaults to localhost dev ports when unset.
#
# ALLOWED_ORIGINS=https://your-app.web.app,http://localhost:8080


# ── 5. Tuning  (optional) ────────────────────────────────────────────────────
# LOG_LEVEL=INFO
# MAX_CONCURRENT_AGENTS=5
# REQUEST_TIMEOUT_SECONDS=60
